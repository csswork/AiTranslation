      "changelog.html",
      "index.html"
    ]
  },
  "版本号取自 <span class=\"mono\">manifest.json</span>。更细的改动可以看仓库的<a class=\"link\" href=\"https://github.com/csswork/AiTranslation/commits/main\" target=\"_blank\" rel=\"noopener\">提交记录</a>。": {
