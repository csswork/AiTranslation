{
  "manifest_version": 3,
  "name": "AI 划词翻译",
  "version": "1.0.0",
  "description": "选中非中文文字后右键「翻译成中文」，用 ChatGPT / DeepSeek 翻译并在屏幕中央弹窗显示。",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/lib/lang.js", "src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "AI 划词翻译",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
