{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.0.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_translateSelection__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/lib/languages.js",
        "src/lib/messages.js",
        "src/lib/i18n.js",
        "src/lib/settings.js",
        "src/lib/requests.js",
        "src/lib/lang.js",
        "src/lib/rules.js",
        "src/lib/selector.js",
        "src/lib/tiles.js",
        "src/content/content.js",
        "src/content/elements.js",
        "src/content/image.js",
        "src/content/pdf.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["http://localhost/*", "https://app.huaci.app/*"],
      "js": ["src/lib/env.js", "src/content/account.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/auth/callback.html"
      ],
      "matches": [
        "http://localhost:8787/*",
        "https://app.huaci.app/*"
      ]
    }
  ],
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en"
}
