    ]
  },
  "不使用广告、埋点或第三方统计 SDK": {
    "kind": "text",
    "tag": "li",
    "pages": [
      "privacy.html"
    ]
  },
  "不出售、不出租你的数据，也不用于广告": {
    "kind": "text",
    "tag": "li",
    "pages": [
