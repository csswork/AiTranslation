    ]
  },
  "<a href=\"./\">首页</a> <a href=\"https://github.com/csswork/AiTranslation\" target=\"_blank\" rel=\"noopener\">GitHub</a> <a href=\"./privacy.html\">隐私政策</a> <a href=\"./terms.html\">服务条款</a> <a href=\"https://github.com/csswork/AiTranslation/issues\" target=\"_blank\" rel=\"noopener\">反馈问题</a> <a href=\"mailto:support@huaci.app\">support@huaci.app</a>": {
