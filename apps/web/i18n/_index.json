  "隐私政策": {
    "kind": "text",
    "tag": "h2",
    "pages": [
      "privacy.html"
    ]
  },
  "最后更新：2026-10-15 · <a class=\"link\" href=\"#english\">English version below</a> · <a class=\"link\" href=\"https://github.com/csswork/AiTranslation/blob/main/PRIVACY.md\" target=\"_blank\" rel=\"noopener\">Markdown 原稿</a>": {
    "kind": "text",
