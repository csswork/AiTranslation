# /etc/systemd/system/huaci-backup.service（由 deploy/setup-server.sh 安装，由 huaci-backup.timer 触发）
[Unit]
Description=Huaci database and config backup to Cloudflare R2
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/huaci-backup
Nice=10
IOSchedulingClass=idle
