# 备份配置模板：setup-server.sh 复制为 /etc/huaci/backup.env（root 600），在服务器上填写，不提交。
# huaci-backup / huaci-restore / huaci-restore-drill 都读取它。说明见 docs/backend/disaster-recovery.md。

# 加密接收方（age 公钥，空格分隔）。至少写运维者离线保管的那把；服务器上的演练钥匙
# （/etc/huaci/backup-drill.key 的公钥）由脚本自动加上，不用写在这里。
AGE_RECIPIENTS=

# Cloudflare R2（主备份）。令牌只授予这个 bucket 的对象读写；bucket 开 30 天锁定规则，
# 过期删除交给 bucket 的生命周期规则，脚本不删除任何对象。
R2_BUCKET=huaci-backup
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# https://<账户 ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# Backblaze B2（异地副本，每天一份）。bucket 开 Object Lock，默认保留 30 天。留空则跳过。
B2_BUCKET=
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=

# healthchecks.io 的检查地址：成功时请求一次，失败时请求 <地址>/fail。留空则不报告。
HC_BACKUP_URL=
HC_DRILL_URL=
