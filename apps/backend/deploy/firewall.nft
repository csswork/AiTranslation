# /etc/huaci/firewall.nft 模板（由 deploy/setup-server.sh 安装，huaci-firewall apply 填入端口与地址段）。
# 只管本服务需要的入站规则，放在独立的表 inet huaci 里，不清空、不改动其他服务的规则。
# @SSH_PORT@、@EXTRA_TCP@、@EXTRA_UDP@、@CF_V4@、@CF_V6@ 由 firewall.sh 替换。
table inet huaci
delete table inet huaci

table inet huaci {
	set cloudflare_v4 {
		type ipv4_addr; flags interval
		elements = { @CF_V4@ }
	}
	set cloudflare_v6 {
		type ipv6_addr; flags interval
		elements = { @CF_V6@ }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif lo accept
		meta l4proto { icmp, ipv6-icmp } accept

		tcp dport @SSH_PORT@ accept
		# 只让 Cloudflare 访问网站；直连源站 IP 的请求一律丢弃
		tcp dport { 80, 443 } ip saddr @cloudflare_v4 accept
		tcp dport { 80, 443 } ip6 saddr @cloudflare_v6 accept
		# 同机其他服务（如 hysteria 的 UDP 443、演示站点的 TCP 端口）
		@EXTRA_TCP@
		@EXTRA_UDP@
	}
}
