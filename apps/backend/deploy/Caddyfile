# /etc/caddy/Caddyfile（由 deploy/setup-server.sh 安装）
# Caddy 自动申请并续期两个域名的 HTTPS 证书，再转发到只监听本机的后端。
#
# 域名经 Cloudflare 代理（橙色云）时，真实访客 IP 在 CF-Connecting-IP 里：只有来自
# Cloudflare 地址段的请求才采信这个头，直连源站的请求用 TCP 对端地址，伪造无效。
# 后端取 X-Forwarded-For 的第一个地址（TRUST_PROXY=1），这里把它改写成单一的可信 IP。
# 地址段来自 https://www.cloudflare.com/ips/ ，Cloudflare 变更时同步更新；huaci-firewall 也从这一行
# 读取地址段，只放行 Cloudflare 访问 80/443，改动后重新运行 huaci-firewall apply / confirm。
#
# 只开 HTTP/1.1 与 HTTP/2：同机的 hysteria 占用 UDP 443，HTTP/3 会冲突；源站在 Cloudflare 后面，
# 访客到 Cloudflare 这一段仍可用 HTTP/3。
#
# 证书：/etc/caddy/tls.d/ 里没有文件时，Caddy 自动向 Let's Encrypt 申请（HTTP-01 经 Cloudflare 转发到 80）；
# 放入 Cloudflare Origin CA 证书后改用它（tls.d/origin.caddy 写一行
# `tls /etc/caddy/tls.d/origin.pem /etc/caddy/tls.d/origin.key`，Cloudflare SSL 模式设为 Full (strict)）。
{
	servers {
		protocols h1 h2
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

app.huaci.app, admin.huaci.app {
	import /etc/caddy/tls.d/*.caddy
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Forwarded-For {client_ip}
	}
}
