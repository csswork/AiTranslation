# 生产配置模板：setup-server.sh 复制为 /etc/huaci/backend.env（root:huaci 640），在服务器上填写，不提交。
# 每行 KEY=value，值不加引号（systemd 与 node --env-file 都按整行读取）。变量说明见 deploy/README.md。

APP_ORIGIN=https://app.huaci.app
ADMIN_ORIGIN=https://admin.huaci.app
WEB_ORIGINS=https://huaci.app
SHARED_COOKIE_DOMAIN=huaci.app
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=1
GEO_COUNTRY_HEADER=cf-ipcountry
REPORT_TIMEZONE=Asia/Shanghai

# 例：postgres://huaci:密码@数据库地址:5432/huaci?sslmode=verify-full
# Amazon RDS 需同时保留下面的 NODE_EXTRA_CA_CERTS；同机或内网无 TLS 的库去掉 sslmode 参数
DATABASE_URL=
NODE_EXTRA_CA_CERTS=/etc/ssl/rds-global-bundle.pem

# setup-server.sh 首次安装时自动生成
AUTH_SECRET=

MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=AI 划词翻译 <no-reply@huaci.app>
SUPPORT_EMAIL=support@huaci.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EXTENSION_IDS=

HOSTED_DEEPSEEK_API_KEY=
HOSTED_FALLBACK_API_KEY=

# 四项要么全填，要么全空（全空时不开放订阅）
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_MONTHLY=
CREEM_PRODUCT_YEARLY=

WEBSITE_URL=https://huaci.app/
EXTENSION_URL=
FEEDBACK_URL=https://github.com/csswork/AiTranslation/issues
