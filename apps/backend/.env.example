# 复制为 apps/backend/.env.local（不提交）。生产环境由 VPS 的进程环境提供，不使用文件。

# 用户管理界面的公开地址；生产环境必须是 HTTPS，例如 https://app.huaci.app
APP_ORIGIN=http://localhost:8787

# 允许读取登录状态、并作为登录后返回地址的官网来源（逗号分隔）。开发默认 http://localhost:8788，生产默认 https://huaci.app。
WEB_ORIGINS=

# 与官网共用语言、配色偏好 Cookie 的父域（生产环境填 huaci.app）；本地开发留空即可（localhost 不区分端口）。
SHARED_COOKIE_DOMAIN=
HOST=127.0.0.1
PORT=8787
# 部署在反向代理之后时设为 1，按 X-Forwarded-For 限流
TRUST_PROXY=

DATABASE_URL=postgres://localhost:5432/huaci_dev

# 至少 32 个字符的随机串，用于邮箱验证码哈希。生成：openssl rand -hex 32
# 开发环境留空时每次启动随机生成。
AUTH_SECRET=

# Google 登录（可选）。授权回调地址：<APP_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 本机需要经代理访问 Google 时设置（Node 的 fetch 不读系统代理），支持 http:// 与 socks5://；VPS 上通常留空。
HTTPS_PROXY=

# 发信方式：console（验证码打印到服务日志，仅限开发）或 resend（生产环境必须）。
MAIL_TRANSPORT=console
# MAIL_TRANSPORT=resend 时必填：Resend API Key 与已在 Resend 验证过的发件地址，例如 AI 划词翻译 <no-reply@huaci.app>
RESEND_API_KEY=
MAIL_FROM=
# 客服邮箱：显示在页脚、套餐页与验证码邮件里（作为回复地址），需与 Creem 后台填写的一致。
SUPPORT_EMAIL=support@huaci.app

# 注册赠送点数与访客（扩展安装后不注册）赠送点数的默认值，都不过期。管理员界面里的设置优先。
TRIAL_CREDITS=200
GUEST_CREDITS=50

# 管理员界面地址（与用户端不同主机名）。开发环境默认 http://admin.localhost:8787；生产环境不设则不提供管理端。
# 管理员用命令行指定：npm run admin -- grant <email>
ADMIN_ORIGIN=
# 本地开发默认跳过管理端二步验证，设为 1 可在本地测试完整流程；生产环境始终要求二步验证。
ADMIN_REQUIRE_2FA=

# 运营报表：按这个时区切分天和小时；反向代理提供两位国家代码的请求头时（如 Cloudflare 的 cf-ipcountry）按国家统计。
REPORT_TIMEZONE=Asia/Shanghai
GEO_COUNTRY_HEADER=
SESSION_DAYS=30

# 帮助页链接。EXTENSION_URL 留空时不显示安装链接。
WEBSITE_URL=https://huaci.app/
EXTENSION_URL=
FEEDBACK_URL=https://github.com/csswork/AiTranslation/issues

# 允许登录的 Chrome 扩展 ID（逗号分隔，32 位 a–p）。生产环境必填；开发环境留空时接受任意扩展。
EXTENSION_IDS=

# 托管文字翻译（点数）。模型 Key 只在服务端，留空时托管翻译不可用。
HOSTED_DEEPSEEK_API_KEY=
HOSTED_MODEL=deepseek-flash
# 备用模型（OpenAI 兼容接口）：主力失败或超时时改用。默认 Fireworks 美国节点上的 DeepSeek V4.1 Flash。
HOSTED_FALLBACK_API_KEY=
HOSTED_FALLBACK_MODEL=
HOSTED_FALLBACK_BASE_URL=
# 单次请求字符上限的默认值（管理员界面可调）。
# 点数固定按 500 字符 = 1 点精确换算，账本存整数字符额度，不设最小扣点。
HOSTED_MAX_CHARS=6000

# Creem 收款与订阅。设置 CREEM_API_KEY 后，Webhook 密钥与两个商品 ID 必填。
# Webhook 地址：<APP_ORIGIN>/webhooks/creem。CREEM_TEST_MODE=1 使用测试环境（test-api.creem.io），生产环境不允许。
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_MONTHLY=
CREEM_PRODUCT_YEARLY=
CREEM_TEST_MODE=
